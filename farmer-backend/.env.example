PORT=8080
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=your-app
FIREBASE_PROJECT_ID=your_project_id
# Local dev: use server/config/serviceAccountKey.json instead (gitignored).
# Production (Fly.io): base64-encode the full JSON file into this variable.
FIREBASE_SERVICE_ACCOUNT_JSON=
NODE_ENV=development
WHATSAPP_APP_SECRET=your_whatsapp_app_secret
WHATSAPP_VERIFY_TOKEN=your_verify_token
